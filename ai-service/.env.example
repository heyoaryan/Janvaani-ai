# ── Server ────────────────────────────────────────────────────────────────────
AI_SERVICE_PORT=8000

# ── Groq API (Free tier — https://console.groq.com) ──────────────────────────
# Sign up free, no credit card needed. ~14,000 requests/day free.
# Leave blank → rule-based local fallback responses are used instead.
GROQ_API_KEY=your_groq_api_key_here

# ── Whisper model size (Speech-to-Text, runs 100% locally) ───────────────────
# tiny  → fastest, ~1GB RAM, decent accuracy
# base  → good balance (RECOMMENDED)
# small → better accuracy, ~2GB RAM
# medium → best accuracy, ~4GB RAM
WHISPER_MODEL=base

# ── Web Search (optional — used as fallback when scheme DB has no answer) ─────
# Only ONE key is needed. Priority: SearchAPI > SerpAPI > Bing
# SearchAPI  → https://www.searchapi.io  (free tier available)
# SerpAPI    → https://serpapi.com       (free tier available)
# Bing       → https://azure.microsoft.com/en-us/services/cognitive-services/bing-web-search-api
SEARCHAPI_KEY=your_searchapi_key_here
SERPAPI_KEY=your_serpapi_key_here
BING_SEARCH_API_KEY=your_bing_key_here
SEARCH_TIMEOUT_MS=6000
