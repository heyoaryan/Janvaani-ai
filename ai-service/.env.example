# ── Server ────────────────────────────────────────────────────────────────────
AI_SERVICE_PORT=8000

# ── Groq API (required for production voice + Indian-language STT) ───────────
# Free key: https://console.groq.com  (no credit card)
# Used for: LLM answers AND Whisper speech-to-text (works on Render without ffmpeg).
# Leave blank → local fallback replies; voice STT then needs faster-whisper + ffmpeg.
GROQ_API_KEY=your_groq_api_key_here

# ── Local Whisper fallback (only if Groq is missing / fails) ─────────────────
# tiny is safest on Render free RAM. Prefer Groq Whisper in production.
WHISPER_MODEL=tiny

# ── Web Search (optional — used as fallback when scheme DB has no answer) ─────
# Only ONE key is needed. Priority: SearchAPI > SerpAPI > Bing
SEARCHAPI_KEY=your_searchapi_key_here
SERPAPI_KEY=your_serpapi_key_here
BING_SEARCH_API_KEY=your_bing_key_here
SEARCH_TIMEOUT_MS=6000
