{
  "private": true,
  "scripts": {
    "install:client": "npm install --prefix client",
    "install:ai": "pip install -r ai-service/requirements.txt",
    "install:all": "npm run install:client && npm run install:ai",

    "dev:client": "npm run dev --prefix client",
    "dev:api": "cd ai-service && uvicorn main:app --reload --port 8000",

    "dev": "concurrently \"npm run dev:client\" \"cd ai-service && uvicorn main:app --reload --port 8000\"",

    "start": "cd ai-service && uvicorn main:app --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
